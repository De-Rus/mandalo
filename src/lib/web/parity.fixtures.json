{
  "readme": [
    "One contract, two engines. Every `wire` block is what the Rust engine actually put on",
    "the socket of a local echo server — captured by src/lib/web/parity-derive.mjs, never",
    "read off the Rust source and guessed. parity.test.ts runs the same fixture through the",
    "browser engine and demands the same bytes; parity-derive.mjs re-runs the CLI and demands",
    "Rust still produces them. A header value written as ~regex is matched as one, for the",
    "values that are generated fresh on every run.",
    "{{BASE}} stands for the echo server's origin.",
    "`http` is the .http source the CLI is given. A fixture marked derivable: false has a",
    "shape the .http format cannot write, so only the browser half of it can be checked."
  ],
  "vars": {
    "seed": "s1",
    "token": "t0ken",
    "id": "7",
    "field": "status",
    "val": "open",
    "term": "x\", \"isAdmin\": true, \"z\": \""
  },
  "fixtures": [
    {
      "name": "bearer",
      "spec": {
        "kind": "http",
        "method": "GET",
        "url": "{{BASE}}/echo?case=bearer",
        "headers": [
          [
            "Authorization",
            "stale"
          ],
          [
            "X-Trace",
            "t-{{seed}}"
          ]
        ],
        "body": null,
        "auth": {
          "type": "bearer",
          "token": "{{token}}"
        },
        "graphql": null
      },
      "wire": {
        "method": "GET",
        "path": "/echo?case=bearer",
        "headers": [
          [
            "authorization",
            "Bearer t0ken"
          ],
          [
            "x-trace",
            "t-s1"
          ]
        ],
        "body": null
      },
      "http": "### bearer\n{{BASE}}/echo?case=bearer\nAuthorization: Bearer {{token}}\nAuthorization: stale\nX-Trace: t-{{seed}}\n"
    },
    {
      "name": "basic",
      "spec": {
        "kind": "http",
        "method": "GET",
        "url": "{{BASE}}/echo?case=basic",
        "headers": [
          [
            "authorization",
            "stale"
          ]
        ],
        "body": null,
        "auth": {
          "type": "basic",
          "username": "u",
          "password": "p"
        },
        "graphql": null
      },
      "wire": {
        "method": "GET",
        "path": "/echo?case=basic",
        "headers": [
          [
            "authorization",
            "Basic dTpw"
          ]
        ],
        "body": null
      },
      "http": "### basic\n{{BASE}}/echo?case=basic\nAuthorization: Basic u:p\nauthorization: stale\n"
    },
    {
      "name": "apikeyheader",
      "spec": {
        "kind": "http",
        "method": "GET",
        "url": "{{BASE}}/echo?case=apikeyheader",
        "headers": [
          [
            "Authorization",
            "custom scheme"
          ]
        ],
        "body": null,
        "auth": {
          "type": "apikey",
          "key": "X-Api-Key",
          "value": "abc",
          "placement": "header"
        },
        "graphql": null
      },
      "wire": {
        "method": "GET",
        "path": "/echo?case=apikeyheader",
        "headers": [
          [
            "authorization",
            "custom scheme"
          ],
          [
            "x-api-key",
            "abc"
          ]
        ],
        "body": null
      },
      "http": "### apikeyheader\n{{BASE}}/echo?case=apikeyheader\nX-Api-Key: abc\nAuthorization: custom scheme\n"
    },
    {
      "name": "apikeyquery",
      "spec": {
        "kind": "http",
        "method": "GET",
        "url": "{{BASE}}/echo?case=apikeyquery&q=1",
        "headers": [],
        "body": null,
        "auth": {
          "type": "apikey",
          "key": "api key",
          "value": "a b&c",
          "placement": "query"
        },
        "graphql": null
      },
      "wire": {
        "method": "GET",
        "path": "/echo?case=apikeyquery&q=1&api+key=a+b%26c",
        "headers": [],
        "body": null
      },
      "derivable": false,
      "why": "a .http file has no line for an api key placed in the query string — Rust refuses to write one, so the CLI can never send this shape and the pin below is the browser's own contract"
    },
    {
      "name": "rawtext",
      "spec": {
        "kind": "http",
        "method": "POST",
        "url": "{{BASE}}/echo?case=rawtext",
        "headers": [],
        "body": "plain words {{seed}}",
        "auth": {
          "type": "none"
        },
        "graphql": null
      },
      "wire": {
        "method": "POST",
        "path": "/echo?case=rawtext",
        "headers": [
          [
            "content-type",
            "text/plain"
          ]
        ],
        "body": "plain words s1"
      },
      "http": "### rawtext\nPOST {{BASE}}/echo?case=rawtext\n\nplain words {{seed}}\n"
    },
    {
      "name": "rawxml",
      "spec": {
        "kind": "http",
        "method": "POST",
        "url": "{{BASE}}/echo?case=rawxml",
        "headers": [],
        "body": "<user id=\"1\"/>",
        "auth": {
          "type": "none"
        },
        "graphql": null
      },
      "wire": {
        "method": "POST",
        "path": "/echo?case=rawxml",
        "headers": [
          [
            "content-type",
            "application/xml"
          ]
        ],
        "body": "<user id=\"1\"/>"
      },
      "http": "### rawxml\nPOST {{BASE}}/echo?case=rawxml\n\n<user id=\"1\"/>\n"
    },
    {
      "name": "rawjson",
      "spec": {
        "kind": "http",
        "method": "POST",
        "url": "{{BASE}}/echo?case=rawjson",
        "headers": [],
        "body": "{\"a\": 1}",
        "auth": {
          "type": "none"
        },
        "graphql": null
      },
      "wire": {
        "method": "POST",
        "path": "/echo?case=rawjson",
        "headers": [
          [
            "content-type",
            "application/json"
          ]
        ],
        "body": "{\"a\": 1}"
      },
      "http": "### rawjson\nPOST {{BASE}}/echo?case=rawjson\n\n{\"a\": 1}\n"
    },
    {
      "name": "rawtextct",
      "spec": {
        "kind": "http",
        "method": "POST",
        "url": "{{BASE}}/echo?case=rawtextct",
        "headers": [
          [
            "Content-Type",
            "application/vnd.acme+json"
          ]
        ],
        "body": "plain words",
        "auth": {
          "type": "none"
        },
        "graphql": null
      },
      "wire": {
        "method": "POST",
        "path": "/echo?case=rawtextct",
        "headers": [
          [
            "content-type",
            "application/vnd.acme+json"
          ]
        ],
        "body": "plain words"
      },
      "http": "### rawtextct\nPOST {{BASE}}/echo?case=rawtextct\nContent-Type: application/vnd.acme+json\n\nplain words\n"
    },
    {
      "name": "graphql",
      "spec": {
        "kind": "graphql",
        "method": "GET",
        "url": "{{BASE}}/echo?case=graphql",
        "headers": [],
        "body": null,
        "auth": {
          "type": "none"
        },
        "graphql": {
          "query": "query Me { me(id: {{id}}) { name } }",
          "variables": "{\"q\":\"{{term}}\", \"filter\": {\"{{field}}\": [\"{{val}}\", 3]}, \"n\": 7}"
        }
      },
      "wire": {
        "method": "POST",
        "path": "/echo?case=graphql",
        "headers": [
          [
            "content-type",
            "application/json"
          ]
        ],
        "body": "{\"query\":\"query Me { me(id: 7) { name } }\",\"variables\":{\"filter\":{\"status\":[\"open\",3]},\"n\":7,\"q\":\"x\\\", \\\"isAdmin\\\": true, \\\"z\\\": \\\"\"}}"
      },
      "http": "### graphql\nPOST {{BASE}}/echo?case=graphql\nX-REQUEST-TYPE: GraphQL\n\nquery Me { me(id: {{id}}) { name } }\n\n{\"q\":\"{{term}}\", \"filter\": {\"{{field}}\": [\"{{val}}\", 3]}, \"n\": 7}\n"
    },
    {
      "name": "graphqlct",
      "spec": {
        "kind": "graphql",
        "method": "POST",
        "url": "{{BASE}}/echo?case=graphqlct",
        "headers": [
          [
            "content-type",
            "application/graphql-response+json"
          ]
        ],
        "body": null,
        "auth": {
          "type": "none"
        },
        "graphql": {
          "query": "{ ping }",
          "variables": ""
        }
      },
      "wire": {
        "method": "POST",
        "path": "/echo?case=graphqlct",
        "headers": [
          [
            "content-type",
            "application/graphql-response+json"
          ]
        ],
        "body": "{\"query\":\"{ ping }\",\"variables\":{}}"
      },
      "http": "### graphqlct\nPOST {{BASE}}/echo?case=graphqlct\nX-REQUEST-TYPE: GraphQL\ncontent-type: application/graphql-response+json\n\n{ ping }\n"
    },
    {
      "name": "dynamic",
      "spec": {
        "kind": "http",
        "method": "POST",
        "url": "{{BASE}}/echo?case=dynamic&id={{$guid}}",
        "headers": [
          [
            "X-Stamp",
            "{{$timestamp}}"
          ],
          [
            "X-Int",
            "{{$randomInt}}"
          ]
        ],
        "body": "hola {{$randomWord}}",
        "auth": {
          "type": "none"
        },
        "graphql": null
      },
      "wire": {
        "method": "POST",
        "path": "~^/echo\\?case=dynamic&id=[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "headers": [
          [
            "content-type",
            "text/plain"
          ],
          [
            "x-int",
            "~^([0-9]|[1-9][0-9]{1,2}|1000)$"
          ],
          [
            "x-stamp",
            "~^[0-9]{10}$"
          ]
        ],
        "body": "~^hola [a-z]+$"
      },
      "http": "### dynamic\nPOST {{BASE}}/echo?case=dynamic&id={{$guid}}\nX-Stamp: {{$timestamp}}\nX-Int: {{$randomInt}}\n\nhola {{$randomWord}}\n"
    },
    {
      "name": "scripts",
      "spec": {
        "kind": "http",
        "method": "POST",
        "url": "{{BASE}}/echo?case=scripts",
        "headers": [],
        "body": "{\"seed\": \"{{seed}}\"}",
        "auth": {
          "type": "none"
        },
        "graphql": null
      },
      "pre": "pm.variables.set('injected', 'yes'); pm.request.headers.upsert({ key: 'X-Injected', value: pm.variables.get('injected') }); pm.test('pre runs', function () { pm.expect(pm.variables.get('seed')).to.equal('s1'); });",
      "post": "pm.test('status is 200', function () { pm.response.to.have.status(200); }); pm.test('deliberate failure', function () { pm.expect(1).to.equal(2); });",
      "scriptTests": [
        [
          "pre runs",
          true
        ],
        [
          "status is 200",
          true
        ],
        [
          "deliberate failure",
          false
        ]
      ],
      "wire": {
        "method": "POST",
        "path": "/echo?case=scripts",
        "headers": [
          [
            "content-type",
            "application/json"
          ],
          [
            "x-injected",
            "yes"
          ]
        ],
        "body": "{\"seed\": \"s1\"}"
      },
      "http": "### scripts\n< {%\npm.variables.set('injected', 'yes'); pm.request.headers.upsert({ key: 'X-Injected', value: pm.variables.get('injected') }); pm.test('pre runs', function () { pm.expect(pm.variables.get('seed')).to.equal('s1'); });\n%}\nPOST {{BASE}}/echo?case=scripts\n\n{\"seed\": \"{{seed}}\"}\n"
    }
  ]
}
