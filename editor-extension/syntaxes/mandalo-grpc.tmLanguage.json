{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mándalo gRPC",
  "scopeName": "source.mandalo-grpc",
  "patterns": [
    { "include": "#separator" },
    { "include": "#script" },
    { "include": "#comment" },
    { "include": "#variable-definition" },
    { "include": "#proto" },
    { "include": "#request-line" },
    { "include": "#header" },
    { "include": "#variable" }
  ],
  "repository": {
    "separator": {
      "match": "^(###+)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.section.mandalo-grpc" },
        "2": { "name": "entity.name.section.mandalo-grpc" }
      }
    },
    "script": {
      "begin": "^[ \\t]*([<>])[ \\t]*(\\{%)",
      "end": "(%\\})",
      "beginCaptures": {
        "1": { "name": "keyword.operator.script.mandalo-grpc" },
        "2": { "name": "punctuation.section.embedded.begin.mandalo-grpc" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.mandalo-grpc" }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [{ "include": "source.js" }]
    },
    "comment": {
      "match": "^[ \\t]*(#|//).*$",
      "name": "comment.line.mandalo-grpc"
    },
    "variable-definition": {
      "match": "^[ \\t]*(@)([A-Za-z0-9_.-]+)[ \\t]*(=)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.variable.mandalo-grpc" },
        "2": { "name": "variable.other.definition.mandalo-grpc" },
        "3": { "name": "keyword.operator.assignment.mandalo-grpc" },
        "4": { "name": "string.unquoted.mandalo-grpc", "patterns": [{ "include": "#variable" }] }
      }
    },
    "proto": {
      "match": "^[ \\t]*(?i:(proto))[ \\t]*(:)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "keyword.control.proto.mandalo-grpc" },
        "2": { "name": "punctuation.separator.key-value.mandalo-grpc" },
        "3": { "name": "string.unquoted.path.mandalo-grpc", "patterns": [{ "include": "#variable" }] }
      }
    },
    "request-line": {
      "match": "^[ \\t]*(\\S+)(/)([A-Za-z0-9_.]+)(/)([A-Za-z0-9_]+)[ \\t]*$",
      "captures": {
        "1": { "name": "markup.underline.link.mandalo-grpc", "patterns": [{ "include": "#variable" }] },
        "2": { "name": "punctuation.separator.mandalo-grpc" },
        "3": { "name": "entity.name.type.service.mandalo-grpc" },
        "4": { "name": "punctuation.separator.mandalo-grpc" },
        "5": { "name": "keyword.control.method.mandalo-grpc" }
      }
    },
    "header": {
      "match": "^[ \\t]*([A-Za-z0-9_.$-]+)[ \\t]*(:)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.metadata.mandalo-grpc" },
        "2": { "name": "punctuation.separator.key-value.mandalo-grpc" },
        "3": { "name": "string.unquoted.metadata.mandalo-grpc", "patterns": [{ "include": "#variable" }] }
      }
    },
    "variable": {
      "match": "(\\{\\{)([^}]*)(\\}\\})",
      "captures": {
        "1": { "name": "punctuation.definition.template.begin.mandalo-grpc" },
        "2": { "name": "variable.other.template.mandalo-grpc" },
        "3": { "name": "punctuation.definition.template.end.mandalo-grpc" }
      }
    }
  }
}
