{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mándalo HTTP",
  "scopeName": "source.mandalo-http",
  "patterns": [
    { "include": "#separator" },
    { "include": "#script" },
    { "include": "#comment" },
    { "include": "#variable-definition" },
    { "include": "#request-line" },
    { "include": "#body-file" },
    { "include": "#header" },
    { "include": "#variable" }
  ],
  "repository": {
    "separator": {
      "match": "^(###+)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.section.mandalo-http" },
        "2": { "name": "entity.name.section.mandalo-http" }
      }
    },
    "script": {
      "begin": "^[ \\t]*([<>])[ \\t]*(\\{%)",
      "end": "(%\\})",
      "beginCaptures": {
        "1": { "name": "keyword.operator.script.mandalo-http" },
        "2": { "name": "punctuation.section.embedded.begin.mandalo-http" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.mandalo-http" }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [{ "include": "source.js" }]
    },
    "comment": {
      "match": "^[ \\t]*(#|//).*$",
      "name": "comment.line.mandalo-http"
    },
    "variable-definition": {
      "match": "^[ \\t]*(@)([A-Za-z0-9_.-]+)[ \\t]*(=)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.variable.mandalo-http" },
        "2": { "name": "variable.other.definition.mandalo-http" },
        "3": { "name": "keyword.operator.assignment.mandalo-http" },
        "4": { "name": "string.unquoted.mandalo-http", "patterns": [{ "include": "#variable" }] }
      }
    },
    "request-line": {
      "match": "^[ \\t]*(?i:(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|TRACE|CONNECT))[ \\t]+(\\S+)(?:[ \\t]+(HTTP/[0-9.]+))?[ \\t]*$",
      "captures": {
        "1": { "name": "keyword.control.method.mandalo-http" },
        "2": { "name": "markup.underline.link.mandalo-http", "patterns": [{ "include": "#variable" }] },
        "3": { "name": "constant.language.version.mandalo-http" }
      }
    },
    "body-file": {
      "match": "^[ \\t]*(<)[ \\t]+(\\S+)[ \\t]*$",
      "captures": {
        "1": { "name": "keyword.operator.body-file.mandalo-http" },
        "2": { "name": "string.unquoted.path.mandalo-http" }
      }
    },
    "header": {
      "match": "^[ \\t]*([A-Za-z0-9_.$-]+)[ \\t]*(:)[ \\t]*(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.header.mandalo-http" },
        "2": { "name": "punctuation.separator.key-value.mandalo-http" },
        "3": { "name": "string.unquoted.header.mandalo-http", "patterns": [{ "include": "#variable" }] }
      }
    },
    "variable": {
      "match": "(\\{\\{)([^}]*)(\\}\\})",
      "captures": {
        "1": { "name": "punctuation.definition.template.begin.mandalo-http" },
        "2": { "name": "variable.other.template.mandalo-http" },
        "3": { "name": "punctuation.definition.template.end.mandalo-http" }
      }
    }
  }
}
