### Gzip body
GET {{baseUrl}}/gzip

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
pm.test("body was gzipped", function () { pm.expect(pm.response.json().encoding).to.equal("gzip"); });
%}

### Binary body
GET {{baseUrl}}/binary

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
%}

### Slow response
GET {{baseUrl}}/slow?ms=300

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
pm.test("under five seconds", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });
%}
