### JSON body
GET {{baseUrl}}/json

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
pm.test("content type is json", function () {
  pm.expect(pm.response.headers.get("content-type")).to.include("application/json");
});
pm.test("nested field arrived", function () { pm.expect(pm.response.json().nested.ok).to.equal(true); });
%}

### Header echo
GET {{baseUrl}}/headers/echo
X-Mandalo: hola

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
%}

### Teapot
GET {{baseUrl}}/status/418

> {%
pm.test("status is 418", function () { pm.response.to.have.status(418); });
%}

### Redirect chain
GET {{baseUrl}}/redirect/3

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
