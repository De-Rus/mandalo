@trace = mandalo

### GET echo
GET {{baseUrl}}/get?page=2&limit=10
X-Trace: {{trace}}

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
pm.test("method is GET", function () { pm.expect(pm.response.json().method).to.equal("GET"); });
%}

### POST echo
POST {{baseUrl}}/post
Content-Type: application/json

{"name": "nova", "tier": "pro"}

> {%
pm.test("status is 200", function () { pm.response.to.have.status(200); });
pm.test("method is POST", function () { pm.expect(pm.response.json().method).to.equal("POST"); });
%}

